# 在 149server 仓库根目录：
#   docker build -f serverB/Dockerfile.v3-C -t rsl_rl_isrc:v3-C .
FROM rsl_rl_isrc:v3-B

ENV PYTHONPATH=/opt:/opt/serverB \
    OBS_ENABLE=1 \
    OBS_HTTP_HOST=127.0.0.1 \
    OBS_HTTP_PORT=15558 \
    OBS_HTTP_PATH=/post \
    OBS_PUB_BIND=0.0.0.0 \
    OBS_PUB_PORT=15557 \
    RSL_RL_ISRC_OBS_RELAY_URL=http://127.0.0.1:15558/post \
    RSL_RL_ISRC_OBS_RELAY_TIMEOUT=0.05

COPY obsserver/src/obsserver /opt/obsserver
COPY serverB/app /opt/serverB/app
COPY serverB/entrypoint.sh /opt/serverB/entrypoint.sh

RUN chmod +x /opt/serverB/entrypoint.sh

WORKDIR /workspace
EXPOSE 8080 15557
ENTRYPOINT ["/opt/serverB/entrypoint.sh"]
